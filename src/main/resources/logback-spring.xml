<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console appender สำหรับ dev / docker -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) [%X{requestId:-}] %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- สามารถเปิด JSON mode ได้โดยใช้ profile: logging.json -->
    <springProfile name="json">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
        </appender>
    </springProfile>

    <!-- ปรับระดับ log ของบาง package -->
    <logger name="com.example.redisdemo" level="INFO"/>
    <logger name="org.springframework.cache" level="INFO"/>
    <logger name="org.springframework.amqp" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
